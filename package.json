{
  "name": "@westlane/pino-blanc",
  "version": "0.1.0",
  "description": "A themed logger to bring order and beauty to your logging experience. Built around Pino for low overhead compatibility with top frameworks and toolkits (Express, Hapi, Koa, VueJS, React, Svelte, Node). Works for browser console and HTML rendering, too.",
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/westlane/pino-blanc.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "pino",
    "logger",
    "logging",
    "pretty",
    "pretty-print",
    "ansi",
    "ndjson",
    "themes",
    "colors",
    "terminal",
    "console",
    "node",
    "browser",
    "react",
    "vue",
    "svelte",
    "pino-transport",
    "structured-logging"
  ],
  "exports": {
    ".": {
      "development": {
        "browser": "./src/browser.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/src/index.d.ts",
      "browser": {
        "types": "./dist/src/browser.d.ts",
        "import": "./dist/src/browser.js",
        "default": "./dist/src/browser.js"
      },
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./browser": {
      "development": "./src/browser.ts",
      "types": "./dist/src/browser.d.ts",
      "import": "./dist/src/browser.js"
    },
    "./pretty": {
      "development": "./src/node/transport/pretty.ts",
      "types": "./dist/src/node/transport/pretty.d.ts",
      "import": "./dist/src/node/transport/pretty.js"
    },
    "./react": {
      "development": "./src/react/index.ts",
      "types": "./dist/src/react/index.d.ts",
      "import": "./dist/src/react/index.js"
    },
    "./vue": {
      "development": "./src/vue/index.ts",
      "types": "./dist/src/vue/index.d.ts",
      "import": "./dist/src/vue/index.js"
    },
    "./svelte": {
      "development": "./src/svelte/index.ts",
      "types": "./dist/src/svelte/index.d.ts",
      "import": "./dist/src/svelte/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "config",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "compile:layout": "node scripts/compile-layout.mjs",
    "build": "rm -rf dist && yarn compile:layout && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "yarn compile:layout && tsc -p tsconfig.json --noEmit",
    "test": "yarn compile:layout && mkdir -p docs/badges && vitest run --reporter=default --reporter=json --outputFile.json=docs/badges/vitest-report.json && node scripts/update-badges.mjs",
    "test:watch": "vitest",
    "badges": "node scripts/update-badges.mjs",
    "demo": "yarn build && node scripts/demo-themes.mjs",
    "demo:live": "yarn verify:ansi && PINO_BLANC_DEMO_FORCE_COLOR=1 node scripts/demo-live-ndjson.mjs",
    "demo:gif": "yarn build && node scripts/render-readme-gif.mjs",
    "demo:node": "yarn build && tsx examples/node-frameworks/main.ts",
    "demo:browser": "vite --config examples/browser-frameworks/vite.config.ts",
    "demo:browser:build": "vite build --config examples/browser-frameworks/vite.config.ts",
    "demo:browser:preview": "vite preview --config examples/browser-frameworks/vite.config.ts",
    "verify:ansi": "yarn build && node scripts/verify-ansi.mjs",
    "check": "yarn lint && yarn typecheck && yarn test && node scripts/verify-readme-badges.mjs && yarn build",
    "prepublishOnly": "yarn check",
    "prepare": "husky"
  },
  "dependencies": {
    "js-yaml": "^5.4.3",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@hapi/hapi": "^21.4.10",
    "@napi-rs/canvas": "^1.0.10",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chance": "^1",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/koa": "^3.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "chance": "^1.1.13",
    "eslint": "^9.28.0",
    "express": "^5.2.1",
    "gifenc": "^1.0.3",
    "globals": "^16.2.0",
    "hapi-pino": "^13.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "koa": "^3.2.1",
    "koa-pino-logger": "^5.0.0",
    "pino-http": "^10.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svelte": "^5.33.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=20"
  }
}
